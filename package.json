{
  "name": "debt-snowball",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:plan && npm run build && node --test tests/rendered-html.test.mjs",
    "build:plan-test": "esbuild app/lib/plan.ts app/lib/release.ts --bundle --format=esm --outdir=dist-test --log-level=warning",
    "test:plan": "npm run build:plan-test && node --test tests/plan.test.mjs tests/release.test.mjs",
    "build:local-client": "vite build --config vite.local.config.ts",
    "build:local-server": "esbuild local-server/server.ts --bundle --platform=node --target=node24 --format=cjs --external:node:sea --outfile=local-dist/server.cjs",
    "build:local-runtime": "npm run build:local-client && npm run build:local-server",
    "start:local": "npm run build:local-runtime && node local-dist/server.cjs",
    "build:exe": "node scripts/build-local-exe.mjs",
    "build:mac": "node scripts/build-mac-executables.mjs",
    "test:local": "npm run build:local-runtime && node --test tests/local-server.test.mjs tests/lifecycle.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postject": "^1.0.0-alpha.6",
    "puppeteer-core": "^25.10.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tar": "^7.5.22",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Debt Snowball"
}
